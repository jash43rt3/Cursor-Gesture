@echo off
title Hand Gesture Virtual Mouse
cd /d "%~dp0"

echo ==============================================
echo   Hand Gesture Virtual Mouse - IVP Project
echo ==============================================

where python >nul 2>nul
if errorlevel 1 goto nopython

if exist "venv\Scripts\activate.bat" goto activate
echo [1/3] Creating virtual environment...
python -m venv venv
if errorlevel 1 goto failed

:activate
call "venv\Scripts\activate.bat"

if exist "venv\.deps_installed" goto run
echo [2/3] Installing dependencies (first run only, please wait)...
python -m pip install --upgrade pip
pip install -r requirements.txt
if errorlevel 1 goto failed
echo done> "venv\.deps_installed"

:run
echo [3/3] Starting... (press Q or Esc in the camera window to quit)
python hand_mouse.py
goto end

:nopython
echo Python was not found. Install Python 3.9 - 3.12 from https://www.python.org
echo and tick "Add Python to PATH" during setup.
goto end

:failed
echo Setup failed. Check your internet connection and Python version (3.9 - 3.12).

:end
echo.
pause
